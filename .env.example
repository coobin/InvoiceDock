# Required in production. Generate with: openssl rand -hex 32
APP_SECRET=change-me-to-a-long-random-secret
APP_BASE_URL=http://localhost:8765
APP_BIND_IP=127.0.0.1
APP_PORT=8765
PUID=1000
PGID=1000
APP_NAME=InvoiceDock · 票舱
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/invoicedock.db
SESSION_HTTPS_ONLY=false

# Bootstrap local administrator (created only when the user table is empty)
ADMIN_USERNAME=kay
ADMIN_PASSWORD=change-me-now
ADMIN_EMAIL=admin@example.com

# Optional OIDC. Local administrator login remains available.
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
OIDC_ALLOWED_DOMAINS=
OIDC_ADMIN_GROUP=
OIDC_GROUP_CLAIM=groups

# Google & GitHub OAuth 第三方登录（可选）
# 配置后登录页将展示快捷登录按钮；第三方认证账号无需邀请码，自动创建并激活。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 若国内服务器无法直连 Google/GitHub，可在此配置 HTTP 代理供 OAuth 请求使用（例如 http://10.1.22.69:1069 或 http://127.0.0.1:7890）
OAUTH_PROXY=


# 邮箱 + 密码自助注册（默认开启）。关闭后仅保留管理员分配的账号与 OIDC。
# OIDC 登录总闸也可由管理员在“查验集成”页实时开关，无需重启。
REGISTRATION_ENABLED=true
REGISTRATION_MIN_PASSWORD_LENGTH=12
PASSWORD_MAX_LENGTH=256
# 注册邀请码强制校验（true=开启必须凭邀请码注册，防止垃圾账号；支持后台动态生成与以下预设静态码）
REGISTRATION_INVITE_REQUIRED=false
REGISTRATION_INVITE_CODES=
# Additional reserved account/display names, comma-separated.
RESERVED_USERNAMES=finance,ceo,财务

# Optional integration overrides (税务 / LLM).
# When set, these values take precedence over database-stored settings and are
# never written to the database. Uncomment to use.
# KINGDEE_ENABLED=true
# KINGDEE_BASE_URL=https://your-tenant.piaozone.com/path
# KINGDEE_APP_ID=
# KINGDEE_APP_SECRET=
# KINGDEE_ACCOUNT_ID=
# KINGDEE_TENANT_ID=1
# KINGDEE_USER=
# KINGDEE_ORG_NUMBER=
# KINGDEE_TAX_NO=
# KINGDEE_COMPANY_NAME=
# LLM_ENABLED=true
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4.1-mini
# LLM_VISION=true
# 查验方式开关（true=允许；关闭本地回退后发票云失败直接进人工复核）
# VERIFY_PROVIDER=true
# VERIFY_OCR=true
# VERIFY_LLM=true
# PIAOZONE_ENABLED=true
# PIAOZONE_BASE_URL=https://api.piaozone.com
# PIAOZONE_CLIENT_ID=
# PIAOZONE_CLIENT_SECRET=
# PIAOZONE_ENCRYPT_KEY=
# PIAOZONE_SIGN_METHOD=MD5
# PIAOZONE_TOKEN_PATH=/base/oauth/token
# PIAOZONE_INVOICE_CHECK_PATH=/m3/bill/invoice/img/Check/info

# 收票抬头预设（JSON 数组，留空=不限抬头）。字段：
# name/tax_id/address/phone/bank_name/bank_account/bank_code
# INVOICE_TITLES_JSON=[{"name":"示例公司","tax_id":"","address":"","phone":"","bank_name":"","bank_account":"","bank_code":""}]

# Limits and scheduler
MAX_UPLOAD_MB=25
MAX_USER_STORAGE_MB=2048
MAX_USER_DAILY_UPLOAD_FILES=200
MAX_USER_DAILY_OCR=200
MAX_USER_DAILY_LLM=100
MAX_CONCURRENT_JOBS_PER_USER=2
MAX_CONCURRENT_PROCESSING_JOBS=4
MAX_ARCHIVE_FILES=30
MAX_ARCHIVE_UNCOMPRESSED_MB=80
MAX_OFD_FILES=200
MAX_OFD_UNCOMPRESSED_MB=100
MAIL_SCAN_INTERVAL_MINUTES=10
MAIL_FETCH_LIMIT=100

# Network boundary. Keep the application port on loopback and list only direct,
# controlled reverse-proxy peers. Uvicorn uses FORWARDED_ALLOW_IPS; the app uses
# TRUSTED_PROXY_IPS before accepting a forwarded client IP.
FORWARDED_ALLOW_IPS=127.0.0.1
TRUSTED_PROXY_IPS=127.0.0.1,::1,172.16.0.0/12
# Admin-approved private destinations for IMAP/LLM integrations. Public HTTPS
# destinations do not need to be listed. Accepts comma-separated hosts/IP/CIDRs.
OUTBOUND_PRIVATE_HOST_ALLOWLIST=
ENABLE_API_DOCS=false

# Container resource and log limits
CONTAINER_PIDS_LIMIT=256
CONTAINER_CPU_LIMIT=2.0
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_TMPFS_SIZE=256m
CONTAINER_LOG_MAX_SIZE=10m
CONTAINER_LOG_MAX_FILES=3
TZ=Asia/Shanghai
LOG_LEVEL=INFO
